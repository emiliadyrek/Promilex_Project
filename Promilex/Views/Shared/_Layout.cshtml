<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PROMILEX</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        :root {
            --promilex-orange: #F9812A;
            --promilex-pink: #E83A61;
            --promilex-bg: #FEF3DC;
            --promilex-teal: #1ABC9C;
            --promilex-crimson: #C0392B;
        }

        body {
            background-color: var(--promilex-bg);
            font-family: 'Segoe UI', Roboto, sans-serif;
            margin: 0;
        }

        .promilex-header {
            background: linear-gradient(90deg, #F9812A 0%, #E83A61 100%);
            padding: 12px 0;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand-custom {
            color: white !important;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .brand-title { font-size: 26px; font-weight: 900; text-transform: uppercase; line-height: 1; }
        .brand-subtitle { font-size: 11px; opacity: 0.9; }

        .nav-buttons-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .promilex-nav-item {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 42px;
            padding: 0 20px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid rgba(255,255,255,0.2);
            color: white !important;
            background-color: rgba(255,255,255,0.15);
        }

        .promilex-nav-item.active-section {
            background-color: white !important;
            color: var(--promilex-orange) !important;
            border: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        .promilex-nav-item:hover {
            background-color: rgba(255,255,255,0.3);
            transform: translateY(-2px);
        }

        .dropdown-menu {
            border-radius: 15px;
            border: none;
            padding: 10px;
            margin-top: 10px !important;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }
        .dropdown-item {
            border-radius: 8px;
            padding: 8px 15px;
            font-weight: 500;
        }
        .dropdown-item:hover {
            background-color: var(--promilex-bg);
            color: var(--promilex-pink);
        }

        .promilex-footer {
            background: linear-gradient(90deg, #F9812A 0%, #E83A61 100%);
            color: white;
            padding: 40px 0;
            margin-top: 60px;
            text-align: center;
        }
    </style>
</head>
<body>
    <header class="promilex-header">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="navbar-brand-custom" asp-controller="Home" asp-action="Index">
                <i class="bi bi-intersect" style="font-size: 28px;"></i>
                <div>
                    <div class="brand-title">PROMILEX</div>
                    <div class="brand-subtitle">Zasoby Premium</div>
                </div>
            </a>

            <nav class="nav-buttons-container">
                @{
                    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                    
                    string prodLabel = "Asortyment";
                    if (controller == "Kategorias") prodLabel = "Kategorie";
                    if (controller == "Producents") prodLabel = "Producenci";
                    if (controller == "Produkts") prodLabel = "Produkty";
                    if (controller == "Skladniks") prodLabel = "Składniki";

                    string firmLabel = "Zasoby Ludzkie";
                    if (controller == "Klients") firmLabel = "Wspólnicy";
                    if (controller == "Zamowienies") firmLabel = "Transakcje";
                    if (controller == "Pracowniks") firmLabel = "Personel";

                    string logLabel = "Relacje";
                    if (controller == "Dostawcas") logLabel = "Dostawcy";
                    if (controller == "Recenzjas") logLabel = "Recenzje";
                }

                <a class="promilex-nav-item @(controller == "Home" ? "active-section" : "")" 
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door me-2"></i> Start
                </a>
                
                <div class="dropdown">
                    <a class="promilex-nav-item dropdown-toggle @(controller == "Produkts" || controller == "Kategorias" || controller == "Producents" || controller == "Skladniks" ? "active-section" : "")" 
                       href="#" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-box-seam me-2"></i> @prodLabel
                    </a>
                    <ul class="dropdown-menu shadow">
                        <li><a class="dropdown-item" asp-controller="Produkts" asp-action="Index"><i class="bi bi-list-ul me-2"></i>Lista Towarów</a></li>
                        <li><a class="dropdown-item" asp-controller="Kategorias" asp-action="Index"><i class="bi bi-tags me-2"></i>Kategorie</a></li>
                        <li><a class="dropdown-item" asp-controller="Producents" asp-action="Index"><i class="bi bi-building me-2"></i>Producenci</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="Skladniks" asp-action="Index"><i class="bi bi-droplet me-2"></i>Składniki (M-M)</a></li>
                    </ul>
                </div>

                <div class="dropdown">
                    <a class="promilex-nav-item dropdown-toggle @(controller == "Klients" || controller == "Zamowienies" || controller == "Pracowniks" ? "active-section" : "")" 
                       href="#" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-lines-fill me-2"></i> @firmLabel
                    </a>
                    <ul class="dropdown-menu shadow">
                        <li><a class="dropdown-item" asp-controller="Klients" asp-action="Index">Wspólnicy (Klienci)</a></li>
                        <li><a class="dropdown-item" asp-controller="Zamowienies" asp-action="Index">Rejestr Zamówień</a></li>
                        <li><a class="dropdown-item" asp-controller="Pracowniks" asp-action="Index">Lista Zasobów (Ludzi)</a></li>
                    </ul>
                </div>

                <div class="dropdown">
                    <a class="promilex-nav-item dropdown-toggle @(controller == "Dostawcas" || controller == "Recenzjas" ? "active-section" : "")" 
                       href="#" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-truck me-2"></i> @logLabel
                    </a>
                    <ul class="dropdown-menu shadow">
                        <li><a class="dropdown-item" asp-controller="Dostawcas" asp-action="Index">Kurierzy (Dostawcy)</a></li>
                        <li><a class="dropdown-item" asp-controller="Recenzjas" asp-action="Index">Ostatnie Słowa (Recenzje)</a></li>
                    </ul>
                </div>
            </nav>
        </div>
    </header>

    <main role="main" class="pb-3">
        <div class="container mt-4">
            @RenderBody()
        </div>
    </main>

    <footer class="promilex-footer">
        <div class="container">
            <h4 class="fw-bold">PROMILEX SYSTEM</h4>
            <p class="small mb-1">Zarządzanie Spiżarnią Premium | © 2026</p>
            <p style="font-size: 11px; opacity: 0.8; font-style: italic;">Pamiętaj: Towar raz wydany nie wraca do żywych.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>