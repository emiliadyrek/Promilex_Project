@model IEnumerable<Promiex.Models.Zamowienie>

@{
    ViewData["Title"] = "Rejestr Zamówień";
}

<style>
    .orders-page {
        background-color: var(--promilex-bg); 
        min-height: 80vh;
        padding-bottom: 60px;
        transition: background-color var(--transition-speed);
    }

    .orders-header {
        text-align: center;
        padding: 60px 0;
    }

    .orders-title {
        font-size: 42px;
        font-weight: 900;
        color: var(--promilex-malina); 
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    .order-card {
        background: var(--card-bg);
        border-radius: 30px;
        border: 1px solid var(--border-color);
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .order-card:hover {
        transform: translateY(-8px);
        border-color: var(--promilex-purple) !important;

        box-shadow: 0 15px 35px rgba(142, 68, 173, 0.25) !important;
    }

    .order-top {
        background: linear-gradient(135deg, var(--promilex-malina) 0%, var(--promilex-purple) 100%);
        padding: 15px 20px;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .order-id {
        font-weight: 800;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .order-content {
        padding: 30px 20px;
        text-align: center;
        flex-grow: 1;
    }

    .order-date {
        font-size: 20px;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 5px;
    }

    .order-client {
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .status-pill {
        display: inline-block;
        padding: 6px 18px;
        background: var(--promilex-bg);
        border: 1px solid var(--promilex-orange); 
        border-radius: 50px;
        color: var(--promilex-orange); 
        font-weight: 800;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-actions-group {
        display: flex;
        justify-content: center;
        gap: 15px;
        padding: 20px;
        background: var(--promilex-bg);
        border-top: 1px solid var(--border-color);
    }

    .circle-btn {
        width: 42px;
        height: 42px;
        border-radius: 14px; 
        display: flex;
        align-items: center;
        justify-content: center;
        color: white !important;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-edit { background-color: #FFB800; }
    .btn-details { background-color: var(--promilex-purple); }
    .btn-delete { background-color: #333; }
    [data-theme="dark"] .btn-delete { background-color: #444; }

    .circle-btn:hover {
        transform: translateY(-3px) scale(1.1);
        filter: brightness(1.1);
    }

    .fab-add {
        position: fixed;
        bottom: 40px;
        right: 40px;
        width: 75px;
        height: 75px;
        background: linear-gradient(135deg, var(--promilex-purple) 0%, var(--promilex-malina) 100%);
        color: white !important;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        box-shadow: 0 10px 25px rgba(142, 68, 173, 0.4);
        z-index: 1000;
        text-decoration: none;
        transition: all 0.4s ease;
    }

    .fab-add:hover {
        transform: scale(1.1) rotate(90deg);
        box-shadow: 0 15px 35px rgba(142, 68, 173, 0.6);
    }
</style>

<div class="orders-page">
    <div class="container">
        
        <div class="orders-header">
            <h1 class="orders-title">Rejestr Zamówień 📝</h1>
            <p class="text-muted">Ruch w interesie musi być! Zarządzaj operacjami poniżej.</p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="order-card shadow-sm">
                        
                        <div class="order-top">
                            <span class="order-id">#ZAM-@item.Id</span>
                            <i class="bi bi-bag-heart-fill"></i>
                        </div>
                        
                        <div class="order-content">
                            <div class="order-date">@item.DataZamowienia.ToString("dd.MM.yyyy")</div>
                            <div class="order-client">
                                <i class="bi bi-person-circle me-1"></i> Wspólnik #@item.KlientId
                            </div>
                            <div class="status-pill">
                                <i class="bi bi-info-circle me-1"></i> @item.Status
                            </div>
                        </div>
                        
                        <div class="btn-actions-group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="circle-btn btn-edit" title="Edytuj">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="circle-btn btn-details" title="Szczegóły">
                                <i class="bi bi-search"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="circle-btn btn-delete" title="Usuń">
                                <i class="bi bi-trash3-fill"></i>
                            </a>
                        </div>

                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center mt-5">
                    <div class="p-5 border border-dashed rounded-5 bg-transparent opacity-75" style="border-style: dashed !important;">
                        <i class="bi bi-clipboard-x display-1 text-muted"></i>
                        <h3 class="mt-3 text-muted">Brak zamówień w bazie</h3>
                        <p>Kliknij plusik w rogu, aby dodać pierwsze!</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<a asp-action="Create" class="fab-add shadow-lg" title="Dodaj nowe zamówienie">
    <i class="bi bi-plus-lg"></i>
</a>