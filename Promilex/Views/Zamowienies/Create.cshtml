@model Promiex.Models.Zamowienie

@{
    ViewData["Title"] = "Nowa Rezerwacja";
}

<style>
    .create-page-wrapper {
        background-color: #FEF3DC;
        min-height: 100vh;
        padding: 60px 0;
        display: flex;
        align-items: center;
    }

    .create-card {
        background: white;
        border-radius: 40px;
        box-shadow: 0 20px 60px rgba(232, 58, 97, 0.1);
        overflow: hidden;
        border: none;
        animation: slideUp 0.5s ease-out;
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .create-header {
        background: linear-gradient(135deg, #E83A61 0%, #F9812A 100%);
        padding: 40px;
        color: white;
        text-align: center;
    }

    .create-header i { font-size: 50px; margin-bottom: 10px; display: block; }

    .create-body { padding: 50px; }

    .form-control {
        border-radius: 15px;
        border: 2px solid #FEF3DC;
        padding: 12px 15px;
        font-weight: 600;
        transition: 0.3s;
    }

    .form-control:focus {
        border-color: #E83A61;
        box-shadow: 0 0 10px rgba(232, 58, 97, 0.1);
        background-color: #fffcf7;
    }

    .btn-create-custom {
        background: linear-gradient(90deg, #F9812A 0%, #E83A61 100%);
        color: white;
        border: none;
        padding: 15px;
        border-radius: 50px;
        font-weight: 800;
        text-transform: uppercase;
        width: 100%;
        transition: 0.3s;
        box-shadow: 0 10px 20px rgba(232, 58, 97, 0.2);
    }

    .btn-create-custom:hover {
        transform: scale(1.02);
        box-shadow: 0 15px 30px rgba(232, 58, 97, 0.4);
        color: white;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 25px;
        color: #666;
        text-decoration: none;
        font-weight: 600;
    }
    .back-link:hover { color: #E83A61; }
</style>

<div class="create-page-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="create-card">
                    <div class="create-header">
                        <i class="bi bi-plus-circle-fill"></i>
                        <h2 class="fw-bold m-0">Nowe Zamówienie</h2>
                        <p class="small opacity-75">Kolejna udana transakcja?</p>
                    </div>
                    <div class="create-body">
                        <form asp-action="Create">
                            <div class="mb-4">
                                <label asp-for="DataZamowienia" class="form-label fw-bold small text-uppercase text-muted">Data</label>
                                <input asp-for="DataZamowienia" class="form-control" />
                            </div>

                            <div class="mb-4">
                                <label asp-for="KlientId" class="form-label fw-bold small text-uppercase text-muted">Numer Wspólnika</label>
                                <input asp-for="KlientId" class="form-control" placeholder="ID" />
                            </div>

                            <div class="mb-5">
                                <label asp-for="Status" class="form-label fw-bold small text-uppercase text-muted">Status</label>
                                <input asp-for="Status" class="form-control" placeholder="np. Gotowe do odbioru" />
                            </div>

                            <button type="submit" class="btn-create-custom">
                                <i class="bi bi-heart-fill me-2"></i> Dodaj zamówienie
                            </button>

                            <a asp-action="Index" class="back-link">Wróć do listy</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>