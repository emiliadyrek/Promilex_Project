@model Promiex.Models.Skladnik

@{
    ViewData["Title"] = "Usuwanie Składnika";
}

<style>
    .delete-skladnik-wrapper {
        background-color: #FEF3DC;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 0;
    }

    .delete-skladnik-card {
        background: white;
        border-radius: 40px;
        box-shadow: 0 20px 60px rgba(142, 68, 173, 0.1); /* Delikatny fioletowy cień */
        padding: 50px;
        max-width: 550px;
        width: 100%;
        text-align: center;
        border-top: 10px solid #dc3545; /* Czerwony dla ostrzeżenia */
        animation: shake 0.5s ease-in-out;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }

    .warning-icon-skladnik {
        font-size: 70px;
        color: #dc3545;
        margin-bottom: 15px;
    }

    .skladnik-info-box {
        background: #fff5f5;
        border: 2px dashed #f8d7da;
        border-radius: 25px;
        padding: 30px;
        margin: 25px 0;
        text-align: center;
    }

    .skladnik-label {
        font-weight: 800;
        color: #999;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }

    .skladnik-value {
        font-size: 28px;
        font-weight: 900;
        color: #333; /* Ciemny tekst dla kontrastu */
    }

    .danger-notice {
        font-size: 13px;
        color: #dc3545;
        background: #fff;
        border: 1px solid #f8d7da;
        padding: 12px;
        border-radius: 15px;
        margin-bottom: 25px;
        font-weight: 600;
    }

    .btn-delete-skladnik {
        background: linear-gradient(90deg, #dc3545 0%, #a71d2a 100%);
        color: white;
        border: none;
        padding: 16px 40px;
        border-radius: 50px;
        font-weight: 800;
        text-transform: uppercase;
        transition: 0.3s;
        box-shadow: 0 10px 20px rgba(220, 53, 69, 0.3);
        width: 100%;
    }

    .btn-delete-skladnik:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(220, 53, 69, 0.5);
        color: white;
    }

    .btn-cancel-skladnik {
        color: #666;
        text-decoration: none;
        font-weight: 700;
        margin-top: 20px;
        display: inline-block;
        transition: 0.3s;
    }

    .btn-cancel-skladnik:hover {
        color: #8E44AD; /* Twój nowy fioletowy przy hoverze */
    }
</style>

<div class="delete-skladnik-wrapper">
    <div class="delete-skladnik-card">
        <div class="warning-icon-skladnik">
            <i class="bi bi-trash3-fill"></i>
        </div>
        
        <h2 class="fw-bold" style="color: #333;">Usunąć składnik?</h2>
        <p class="text-muted">Ten element zostanie trwale wycofany z bazy receptur.</p>

        <div class="skladnik-info-box">
            <div class="skladnik-label">Nazwa elementu</div>
            <div class="skladnik-value">@Model.Nazwa</div>
        </div>

        <div class="danger-notice">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            Uwaga: Składnik zostanie odpięty od wszystkich produktów!
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex flex-column align-items-center">
                <button type="submit" class="btn-delete-skladnik">
                    <i class="bi bi-fire me-2"></i> Potwierdzam usunięcie
                </button>
                <a asp-action="Index" class="btn-cancel-skladnik">
                    <i class="bi bi-arrow-left me-1"></i> Nie usuwaj, wróć
                </a>
            </div>
        </form>
    </div>
</div>