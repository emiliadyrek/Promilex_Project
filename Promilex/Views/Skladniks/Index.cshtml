@model IEnumerable<Promiex.Models.Skladnik>

@{
    ViewData["Title"] = "Baza Receptur";
}

<style>
    .skladnik-index-wrapper {
        background-color: var(--promilex-bg); 
        min-height: 80vh;
        padding-bottom: 60px;
        transition: background-color var(--transition-speed);
    }

    .skladnik-header {
        text-align: center;
        padding: 60px 0;
    }

    .skladnik-title {
        font-size: 48px;
        font-weight: 900;
        color: var(--promilex-purple);
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    .skladnik-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
    }

    .skladnik-item-card {
        background: var(--card-bg);
        border-radius: 30px;
        padding: 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 1px solid var(--border-color);
    }

    .skladnik-item-card:hover {
        transform: translateY(-8px);
        border-color: var(--promilex-purple) !important;
        box-shadow: 0 15px 35px rgba(142, 68, 173, 0.25) !important;
    }

    .skladnik-main-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .skladnik-icon-box {
        width: 55px;
        height: 55px;
        background: var(--promilex-bg); 
        color: var(--promilex-purple);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        border: 1px solid var(--border-color);
        transition: 0.3s;
    }

    .skladnik-item-card:hover .skladnik-icon-box {
        background: var(--promilex-purple);
        color: white;
        transform: rotate(15deg);
    }

    .skladnik-name {
        font-weight: 800;
        font-size: 20px;
        color: var(--text-main);
        margin: 0;
        line-height: 1.1;
    }

    .usage-badge {
        font-size: 11px;
        background: linear-gradient(90deg, var(--promilex-purple) 0%, var(--promilex-malina) 100%); 
        color: white;
        padding: 4px 12px;
        border-radius: 50px;
        font-weight: 800;
        text-transform: uppercase;
        margin-top: 5px;
        display: inline-block;
        box-shadow: 0 4px 10px rgba(142, 68, 173, 0.2);
    }

    .skladnik-actions {
        display: flex;
        gap: 10px;
    }

    .circle-btn-sm {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 15px;
        color: white !important;
    }

    .btn-edit-sm { background: #FFB800; }
    .btn-details-sm { background: var(--promilex-purple); } 
    .btn-delete-sm { background: #333; }
    [data-theme="dark"] .btn-delete-sm { background: #444; }

    .circle-btn-sm:hover {
        transform: scale(1.15) translateY(-2px);
        filter: brightness(1.1);
    }

    .fab-add-skladnik {
        position: fixed;
        bottom: 40px;
        right: 40px;
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, var(--promilex-purple) 0%, var(--promilex-malina) 100%); 
        color: white !important;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        box-shadow: 0 15px 35px rgba(142, 68, 173, 0.4);
        text-decoration: none;
        z-index: 1000;
        transition: 0.4s;
    }

    .fab-add-skladnik:hover {
        transform: rotate(90deg) scale(1.1);
        box-shadow: 0 20px 45px rgba(199, 21, 133, 0.6);
    }
</style>

<div class="skladnik-index-wrapper">
    <div class="container">
        <div class="skladnik-header">
            <h1 class="skladnik-title">Baza Receptur</h1>
            <p class="text-muted">Twoje tajne składniki i dodatki.</p>
        </div>

        <div class="skladnik-grid">
            @foreach (var item in Model) {
                <div class="skladnik-item-card shadow-sm">
                    <div class="skladnik-main-info">
                        <div class="skladnik-icon-box">
                            <i class="bi bi-heptagon-fill"></i>
                        </div>
                        <div>
                            <h3 class="skladnik-name">@item.Nazwa</h3>
                            <span class="usage-badge">
                                <i class="bi bi-stars me-1"></i> 
                                W użyciu: @(item.Produkty?.Count() ?? 0)
                            </span>
                        </div>
                    </div>

                    <div class="skladnik-actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="circle-btn-sm btn-edit-sm" title="Edytuj">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="circle-btn-sm btn-details-sm" title="Szczegóły">
                            <i class="bi bi-search"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="circle-btn-sm btn-delete-sm" title="Usuń">
                            <i class="bi bi-trash3-fill"></i>
                        </a>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-patch-question text-muted display-1 opacity-25"></i>
                    <p class="mt-3 text-muted">Brak składników? Czas dodać coś do kociołka!</p>
                </div>
            }
        </div>
    </div>
</div>

<a asp-action="Create" class="fab-add-skladnik shadow-lg" title="Dodaj nowy składnik">
    <i class="bi bi-plus-lg"></i>
</a>