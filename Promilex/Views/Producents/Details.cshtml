@model Promiex.Models.Producent

@{
    ViewData["Title"] = "Profil Producenta";
}

<style>
    .details-producer-wrapper {
        background-color: #FEF3DC;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
    }

    .producer-profile-card {
        background: white;
        border-radius: 40px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        max-width: 700px;
        width: 100%;
        overflow: hidden;
        border: none;
    }

    .producer-cover {
        background: linear-gradient(135deg, #2C3E50 0%, #34495E 100%);
        height: 150px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .producer-avatar-circle {
        width: 120px;
        height: 120px;
        background: white;
        border-radius: 30px; 
        position: absolute;
        bottom: -60px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 50px;
        color: #2C3E50;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border: 5px solid white;
    }

    .producer-info-section {
        padding: 80px 50px 40px 50px;
        text-align: center;
    }

    .producer-main-title {
        font-size: 36px;
        font-weight: 900;
        color: #2C3E50;
        margin-bottom: 5px;
    }

    .country-tag {
        display: inline-flex;
        align-items: center;
        background: #f0f4f8;
        padding: 8px 20px;
        border-radius: 50px;
        color: #3498DB;
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 30px;
    }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 40px;
    }

    .detail-item {
        background: #fdfdfd;
        border: 1px solid #f0f0f0;
        padding: 20px;
        border-radius: 20px;
        transition: 0.3s;
    }

        .detail-item:hover {
            border-color: #3498DB;
            background: #f8fbff;
        }

    .detail-label {
        font-size: 11px;
        font-weight: 800;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 5px;
        display: block;
    }

    .detail-value {
        font-size: 18px;
        font-weight: 700;
        color: #333;
    }

    .action-row {
        display: flex;
        gap: 15px;
        justify-content: center;
        border-top: 2px solid #FEF3DC;
        padding-top: 30px;
    }

    .btn-p-edit {
        background: #2C3E50;
        color: white;
        padding: 12px 30px;
        border-radius: 50px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-p-edit:hover {
            background: #3498DB;
            color: white;
            transform: translateY(-2px);
        }

    .btn-p-back {
        background: white;
        color: #666;
        padding: 12px 30px;
        border-radius: 50px;
        font-weight: 700;
        text-decoration: none;
        border: 2px solid #eee;
        transition: 0.3s;
    }

        .btn-p-back:hover {
            border-color: #2C3E50;
            color: #2C3E50;
        }
</style>

<div class="details-producer-wrapper">
    <div class="producer-profile-card shadow-lg">
        <div class="producer-cover">
            <div class="producer-avatar-circle">
                <i class="bi bi-building-up"></i>
            </div>
        </div>

        <div class="producer-info-section">
            <h1 class="producer-main-title">@Html.DisplayFor(model => model.Nazwa)</h1>
            <div class="country-tag shadow-sm">
                <i class="bi bi-globe-americas me-2"></i> @Html.DisplayFor(model => model.KrajPochodzenia)
            </div>

            <div class="details-grid text-start">
                <div class="detail-item">
                    <span class="detail-label">Status Partnera</span>
                    <span class="detail-value">Zweryfikowany <i class="bi bi-patch-check-fill text-primary small"></i></span>
                </div>
                <div class="detail-item text-end">
                    <span class="detail-label">ID Dostawcy</span>
                    <span class="detail-value">#00@Model.Id</span>
                </div>
            </div>

            <p class="text-muted small mb-5">
                Oficjalne dane producenta zarejestrowane w systemie Promilex. <br>
                Wszystkie powiązane produkty zostaną zaktualizowane automatycznie przy zmianie danych.
            </p>

            <div class="action-row">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-p-edit shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edytuj dane
                </a>
                <a asp-action="Index" class="btn-p-back">
                    <i class="bi bi-list-check me-1"></i> Lista dostawców
                </a>
            </div>
        </div>
    </div>
</div>