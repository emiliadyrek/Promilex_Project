@model Promiex.Models.Producent

@{
    ViewData["Title"] = "Usuwanie Producenta";
}

<style>
    .delete-producer-wrapper {
        background-color: #FEF3DC;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .delete-producer-card {
        background: white;
        border-radius: 40px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        max-width: 550px;
        width: 100%;
        overflow: hidden;
        border: none;
    }

    .delete-producer-header {
        background: #2C3E50; 
        padding: 40px;
        color: white;
        text-align: center;
        position: relative;
    }

    .warning-strip {
        background: #E83A61;
        height: 6px;
        width: 100%;
        position: absolute;
        top: 0;
        left: 0;
    }

    .producer-icon-container {
        font-size: 50px;
        color: #E83A61;
        margin-bottom: 10px;
        animation: shake 0.5s infinite;
    }

    @@keyframes shake {
        0% { transform: rotate(0deg); }
        25% { transform: rotate(5deg); }
        75% { transform: rotate(-5deg); }
        100% { transform: rotate(0deg); }
    }

    .delete-producer-body {
        padding: 45px;
        text-align: center;
    }

    .producer-data-box {
        background: #f8fbff;
        border: 2px solid #FEF3DC;
        border-radius: 20px;
        padding: 25px;
        margin: 25px 0;
        text-align: left;
    }

    .data-label {
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 800;
        color: #3498DB;
        letter-spacing: 1px;
    }

    .data-value {
        font-size: 20px;
        font-weight: 700;
        color: #2C3E50;
        margin-bottom: 15px;
    }

    .btn-delete-confirm {
        background: #E83A61;
        color: white;
        border: none;
        padding: 16px 40px;
        border-radius: 50px;
        font-weight: 800;
        text-transform: uppercase;
        width: 100%;
        transition: all 0.3s;
        box-shadow: 0 10px 20px rgba(232, 58, 97, 0.2);
    }

    .btn-delete-confirm:hover {
        background: #333;
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        color: white;
    }

    .cancel-link {
        display: block;
        margin-top: 20px;
        color: #666;
        text-decoration: none;
        font-weight: 600;
    }

    .cancel-link:hover { color: #2C3E50; }
</style>

<div class="delete-producer-wrapper">
    <div class="delete-producer-card animate-in">
        <div class="delete-producer-header">
            <div class="warning-strip"></div>
            <div class="producer-icon-container">
                <i class="bi bi-building-dash"></i>
            </div>
            <h2 class="fw-bold m-0">Zrywasz współpracę?</h2>
            <p class="small opacity-75 mt-2">Usunięcie producenta jest nieodwracalne.</p>
        </div>

        <div class="delete-producer-body">
            <p class="text-muted">Potwierdź, że chcesz usunąć poniższy podmiot z bazy:</p>

            <div class="producer-data-box">
                <div class="data-label">Pełna nazwa</div>
                <div class="data-value">@Html.DisplayFor(model => model.Nazwa)</div>

                <div class="data-label">Kraj pochodzenia</div>
                <div class="data-value mb-0">
                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i> @Html.DisplayFor(model => model.KrajPochodzenia)
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn-delete-confirm">
                    <i class="bi bi-trash3-fill me-2"></i> Tak, usuń producenta
                </button>
                <a asp-action="Index" class="cancel-link">
                    <i class="bi bi-arrow-left-circle me-1"></i> Nie, zachowaj go
                </a>
            </form>
        </div>
    </div>
</div>