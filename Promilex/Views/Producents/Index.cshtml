@model IEnumerable<Promiex.Models.Producent>

@{
    ViewData["Title"] = "Baza Producentów";
}

<style>
    .producer-index-wrapper {
        background-color: var(--promilex-bg);
        min-height: 80vh;
        padding: 40px 0;
        transition: background-color var(--transition-speed);
    }

    .producer-header {
        text-align: center;
        margin-bottom: 50px;
    }

    .producer-title {
        font-size: 42px;
        font-weight: 900;
        color: var(--promilex-purple);
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    .producer-card {
        background: var(--card-bg);
        border-radius: 30px;
        padding: 35px 25px;
        border: 1px solid var(--border-color);
        height: 100%;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
    }

        .producer-card:hover {
            transform: translateY(-10px);
            border-color: var(--promilex-purple) !important;
            box-shadow: 0 15px 40px rgba(142, 68, 173, 0.3) !important;
        }

    .producer-icon-box {
        width: 75px;
        height: 75px;
        background: var(--promilex-bg);
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        color: var(--promilex-purple);
        margin-bottom: 20px;
        transition: 0.3s;
        border: 1px solid var(--border-color);
    }

    .producer-card:hover .producer-icon-box {
        background: var(--promilex-purple);
        color: white;
        transform: rotate(-5deg) scale(1.1);
    }

    .producer-name {
        font-size: 22px;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 5px;
    }

    .producer-country {
        font-size: 14px;
        color: var(--text-muted);
        font-weight: 600;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .action-group-pill {
        display: flex;
        gap: 12px;
        margin-top: auto;
        background: var(--promilex-bg);
        padding: 10px 20px;
        border-radius: 50px;
        border: 1px solid var(--border-color);
        transition: 0.3s;
    }

    .producer-card:hover .action-group-pill {
        border-color: var(--promilex-purple);
    }

    .action-btn-mini {
        color: var(--text-main);
        text-decoration: none;
        font-size: 18px;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .action-btn-mini:hover {
            color: var(--promilex-malina) !important;
            transform: scale(1.25);
        }

        .action-btn-mini.btn-delete:hover {
            color: #dc3545 !important; 
        }

    .fab-add-producer {
        position: fixed;
        bottom: 40px;
        right: 40px;
        width: 75px;
        height: 75px;
        background: linear-gradient(135deg, var(--promilex-purple), var(--promilex-malina));
        color: white !important;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        box-shadow: 0 10px 30px rgba(142, 68, 173, 0.4);
        transition: all 0.3s ease;
        text-decoration: none;
        z-index: 1000;
    }

        .fab-add-producer:hover {
            transform: scale(1.1) rotate(90deg);
            box-shadow: 0 15px 35px rgba(142, 68, 173, 0.6);
        }
</style>

<div class="producer-index-wrapper">
    <div class="container">
        <div class="producer-header">
            <h1 class="producer-title">Baza Producentów 🏢</h1>
            <p class="text-muted">Lista kontaktów, których nie powinieneś wybierać po 22:00.</p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="producer-card shadow-sm">
                        <div class="producer-icon-box shadow-sm">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>
                        <div class="producer-name">@item.Nazwa</div>
                        <div class="producer-country">
                            <i class="bi bi-globe-europe-africa"></i> @item.KrajPochodzenia
                        </div>
                        <div class="action-group-pill">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn-mini" title="Edytuj dane">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn-mini" title="Szczegóły">
                                <i class="bi bi-info-circle-fill"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn-mini btn-delete" title="Usuń producenta">
                                <i class="bi bi-trash3-fill"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="opacity-25 display-1 mb-3 text-muted">🏢</div>
                    <h3 class="text-muted fw-light">Baza producentów jest pusta.</h3>
                    <p class="text-muted small">Użyj wielkiego plusa w rogu, aby dodać pierwszą firmę.</p>
                </div>
            }
        </div>
    </div>
</div>

<a asp-action="Create" class="fab-add-producer shadow-lg" title="Dodaj nowego producenta">
    <i class="bi bi-plus-lg"></i>
</a>