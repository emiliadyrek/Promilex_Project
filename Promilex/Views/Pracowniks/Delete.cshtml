@model Promiex.Models.Pracownik

@{
    ViewData["Title"] = "Usuwanie Pracownika";
}

<style>
    .delete-page-wrapper {
        background-color: #FEF3DC; 
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .delete-card {
        background: white;
        border-radius: 40px;
        box-shadow: 0 20px 60px rgba(108, 92, 231, 0.15);
        overflow: hidden;
        width: 100%;
        max-width: 500px;
        border: none;
        animation: shake 0.5s ease-in-out;
    }

    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }

    .delete-header {
        background: linear-gradient(135deg, #6C5CE7 0%, #E83A61 100%);
        padding: 40px;
        color: white;
        text-align: center;
    }

    .delete-header i {
        font-size: 60px;
        margin-bottom: 15px;
        display: block;
        color: #FFB800; 
    }

    .delete-body {
        padding: 40px;
    }

    .worker-info-box {
        background: #fffcf7;
        border-radius: 25px;
        padding: 30px;
        margin-bottom: 30px;
        border: 2px solid #FEF3DC;
        border-left: 8px solid #6C5CE7;
        text-align: center;
    }

    .worker-avatar {
        width: 70px;
        height: 70px;
        background: #FEF3DC;
        color: #6C5CE7;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin: 0 auto 15px;
    }

    .info-label {
        font-weight: 800;
        font-size: 11px;
        text-transform: uppercase;
        color: #F9812A;
        letter-spacing: 1.5px;
        margin-bottom: 4px;
    }

    .info-value {
        font-size: 20px;
        font-weight: 700;
        color: #333;
        margin-bottom: 15px;
    }

    .stanowisko-tag {
        display: inline-block;
        background: #6C5CE7;
        color: white;
        padding: 5px 15px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .btn-delete-confirm {
        background: #E83A61; 
        color: white;
        border: none;
        padding: 18px;
        border-radius: 50px;
        font-weight: 800;
        text-transform: uppercase;
        width: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(232, 58, 97, 0.25);
    }

    .btn-delete-confirm:hover {
        background: #C02E50;
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(232, 58, 97, 0.4);
        color: white;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 25px;
        color: #7F8C8D;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
    }

    .back-link:hover {
        color: #6C5CE7;
    }
</style>

<div class="delete-page-wrapper">
    <div class="delete-card shadow-lg">
        
        <div class="delete-header">
            <i class="bi bi-person-x-fill"></i>
            <h2 class="fw-bold m-0 h3">Żegnamy kolegę?</h2>
            <p class="small opacity-90 mt-2">Usunięcie pracownika jest nieodwracalne.</p>
        </div>

        <div class="delete-body">
            <h5 class="text-center mb-4 fw-bold" style="color: #333;">Czy na pewno chcesz usunąć tę osobę?</h5>

            <div class="worker-info-box">
                <div class="worker-avatar">
                    <i class="bi bi-person-vcard"></i>
                </div>
                
                <div class="info-label">Pracownik</div>
                <div class="info-value">@Model.Imie @Model.Nazwisko</div>

                <div class="info-label">Pełniona funkcja</div>
                <div class="stanowisko-tag">
                    @Model.Stanowisko
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                
                <button type="submit" class="btn-delete-confirm">
                    <i class="bi bi-person-dash-fill me-2"></i> Potwierdź zwolnienie
                </button>

                <a asp-action="Index" class="back-link">
                    <i class="bi bi-arrow-left-short"></i> Nie, zostaje z nami
                </a>
            </form>
        </div>
    </div>
</div>