@model IEnumerable<Promiex.Models.Pracownik>

@{
    ViewData["Title"] = "Zespół Promiex";
}

<style>
    .workers-page {
        background-color: var(--promilex-bg); 
        min-height: 80vh;
        padding-bottom: 60px;
        transition: background-color var(--transition-speed);
    }

    .workers-header {
        text-align: center;
        padding: 60px 0;
    }

    .workers-title {
        font-size: 42px;
        font-weight: 900;
        color: var(--promilex-purple); 
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    .worker-card {
        background: var(--card-bg);
        border-radius: 35px;
        border: 1px solid var(--border-color);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .worker-card:hover {
        transform: translateY(-10px);
        border-color: var(--promilex-purple) !important;
        box-shadow: 0 15px 40px rgba(142, 68, 173, 0.3) !important;
    }

    .worker-top {
        background: linear-gradient(135deg, var(--promilex-purple) 0%, var(--promilex-malina) 100%);
        padding: 25px;
        text-align: center;
        color: white;
    }

    .worker-avatar-circle {
        width: 75px;
        height: 75px;
        background: rgba(255, 255, 255, 0.15);
        border: 2px solid rgba(255, 255, 255, 0.5);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin: 0 auto;
        transition: 0.3s;
    }

    .worker-card:hover .worker-avatar-circle {
        border-color: #FFB800; 
        transform: scale(1.1);
    }

    .worker-content {
        padding: 25px 20px;
        text-align: center;
        flex-grow: 1;
    }

    .worker-name {
        font-size: 20px;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 8px;
    }

    .worker-position {
        display: inline-block;
        padding: 5px 18px;
        background: var(--promilex-bg);
        border: 1px solid var(--border-color);
        border-radius: 50px;
        color: var(--promilex-malina);
        font-weight: 700;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .worker-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        padding: 20px;
        background: var(--promilex-bg);
        border-top: 1px solid var(--border-color);
        transition: background-color var(--transition-speed);
    }

    .circle-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white !important;
        text-decoration: none;
        transition: 0.3s;
    }

    .btn-edit { background: #FFB800; }
    .btn-details { background: var(--promilex-purple); }
    .btn-delete { background: #333; }
    
    [data-theme="dark"] .btn-delete { background: #555; }

    .circle-btn:hover {
        transform: translateY(-3px) scale(1.1);
        filter: brightness(1.1);
    }

    .fab-add {
        position: fixed;
        bottom: 40px;
        right: 40px;
        width: 75px;
        height: 75px;
        background: linear-gradient(135deg, var(--promilex-purple) 0%, var(--promilex-malina) 100%);
        color: white !important;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        box-shadow: 0 10px 25px rgba(142, 68, 173, 0.4);
        z-index: 1000;
        text-decoration: none;
        transition: all 0.4s ease;
    }

    .fab-add:hover {
        transform: scale(1.1) rotate(90deg);
        box-shadow: 0 15px 30px rgba(142, 68, 173, 0.6);
    }
</style>

<div class="workers-page">
    <div class="container">
        
        <div class="workers-header">
            <h1 class="workers-title">Zasoby Ludzkie 👤</h1>
            <p class="text-muted">Ludzie, którzy napędzają mechanizm Twojej spiżarni.</p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="worker-card shadow-sm">
                        <div class="worker-top">
                            <div class="worker-avatar-circle">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        </div>
                        
                        <div class="worker-content">
                            <div class="worker-name">@item.Imie @item.Nazwisko</div>
                            <div class="worker-position">@item.Stanowisko</div>
                        </div>

                        <div class="worker-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="circle-btn btn-edit" title="Edytuj profil">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="circle-btn btn-details" title="Szczegóły">
                                <i class="bi bi-search"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="circle-btn btn-delete" title="Usuń z zespołu">
                                <i class="bi bi-person-x-fill"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center mt-5">
                    <div class="p-5 border border-dashed rounded-5 bg-transparent opacity-75" style="border-style: dashed !important;">
                        <i class="bi bi-people display-1 text-muted"></i>
                        <h3 class="mt-3 text-muted">Brak personelu w bazie</h3>
                        <p>Zatrudnij kogoś klikając plusik w rogu!</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<a asp-action="Create" class="fab-add shadow-lg" title="Dodaj nowego pracownika">
    <i class="bi bi-plus-lg"></i>
</a>