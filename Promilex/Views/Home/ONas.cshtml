@{
    ViewData["Title"] = "O nas";
}

<style>
    .on-page-wrapper {
        background-color: var(--promilex-bg);
        min-height: 100vh;
        padding-bottom: 80px;
        transition: background-color var(--transition-speed);
        animation: fadeInPage 0.8s ease-in-out;
    }

    @@keyframes fadeInPage {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .on-header {
        text-align: center;
        padding: 80px 0;
    }

    .on-title {
        font-size: 50px;
        font-weight: 800;
        color: var(--promilex-purple);
        letter-spacing: 1px;
        transition: transform 0.3s ease;
    }

    .on-title:hover { transform: scale(1.05); }

    .history-card {
        background: var(--card-bg);
        border-radius: 35px;
        border: 1px solid var(--border-color);
        padding: 40px;
        display: flex;
        align-items: center;
        gap: 40px;
        margin-bottom: 80px;
        transition: all 0.4s ease;
    }

    .history-card:hover {
        transform: translateY(-5px);
        border-color: var(--promilex-purple);
        box-shadow: 0 20px 40px rgba(142, 68, 173, 0.15);
    }

    .history-image {
        flex: 1;
        height: 400px;
        object-fit: cover;
        border-radius: 25px;
    }

    .history-text {
        color: var(--text-main);
    }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 30px;
        padding: 40px;
        text-align: center;
        height: 100%;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .stat-card:hover {
        transform: translateY(-10px);
        border-color: var(--promilex-purple);
        box-shadow: 0 15px 35px rgba(142, 68, 173, 0.3);
    }

    .stat-icon-box {
        width: 65px;
        height: 65px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        color: white;
        margin: 0 auto 25px auto;
    }

    .team-card {
        background: var(--card-bg); 
        border: 1px solid var(--border-color);
        border-radius: 30px;
        padding: 35px;
        text-align: center;
        height: 100%;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
    }

    .team-card:hover {
        transform: translateY(-10px);
        border-color: var(--promilex-purple);
        box-shadow: 0 20px 45px rgba(142, 68, 173, 0.35); 
    }

    [data-theme="light"] .team-card.team-marek { background: linear-gradient(135deg, #ffffff 0%, #FFEFD6 100%); }
    [data-theme="light"] .team-card.team-anna { background: linear-gradient(135deg, #ffffff 0%, #FEF0F7 100%); }
    [data-theme="light"] .team-card.team-piotr { background: linear-gradient(135deg, #ffffff 0%, #FFF8E6 100%); }

    .team-avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: var(--promilex-bg);
        padding: 5px;
        margin-bottom: 20px;
        border: 2px solid var(--border-color);
    }

    .team-name { color: var(--text-main); font-weight: 800; }
    .team-role { color: var(--promilex-purple); font-weight: 700; font-size: 14px; }
    .team-desc { color: var(--text-muted); font-style: italic; font-size: 13px; }

    .contact-cta-wrapper {
        background: linear-gradient(135deg, var(--promilex-purple) 0%, var(--promilex-malina) 100%);
        border-radius: 35px;
        padding: 60px;
        color: white;
        margin: 80px 0;
        box-shadow: 0 20px 50px rgba(142, 68, 173, 0.3);
    }

    .contact-item {
        background-color: rgba(255,255,255,0.15);
        border-radius: 20px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
        transition: all 0.3s ease;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .contact-item:hover {
        background-color: rgba(255,255,255,0.25);
        transform: translateX(10px);
    }

    .curiosity-box {
        background: var(--card-bg);
        border-radius: 25px;
        padding: 30px;
        color: var(--text-muted);
        border-left: 6px solid var(--promilex-orange);
        margin: 60px 0;
        border-top: 1px solid var(--border-color);
        border-right: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }
</style>

<div class="on-page-wrapper">
    <div class="container">
        
        <div class="on-header">
            <h1 class="on-title">O nas ✨</h1>
            <p class="lead text-muted">Odkryj historię najlepszego zaopatrzenia w mieście!</p>
        </div>

        <div class="history-card shadow-sm">
            <img src="~/images/neon_cocktail.png" class="history-image shadow-sm" alt="Klimat Promilex">
            <div class="history-text">
                <h2 class="fw-bold mb-3" style="color: var(--promilex-malina);">Nasza Historia 📖</h2>
                <p class="mb-3">Promilex powstał w 2011 roku z pasji do najlepszych alkoholi świata. Od tamtej pory nieprzerwanie serwujemy naszym klientom najwyższą jakość w przystępnych cenach!</p>
                <p class="mb-3">Jesteśmy dumni z naszej kolekcji win z Francji, whisky ze Szkocji i craftowych piw z lokalnych browarów. Każdy produkt jest starannie wyselekcjonowany!</p>
                <p>W weekendy organizujemy darmowe degustacje - to świetna okazja, żeby poznać nowe smaki!</p>
                <p class="text-muted small fst-italic mt-3">*(Wszystkie opinie klientów zostały zebrane przed otwarciem trzeciej butelki)</p>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon-box" style="background-color: var(--promilex-orange);"><i class="bi bi-award"></i></div>
                    <h1 class="display-3 fw-bold" style="color: var(--promilex-orange);">
                        <span class="counter" data-target="15">0</span>+
                    </h1>
                    <p class="fw-bold text-muted">Lat doświadczenia <br><small>(i cierpienia)</small></p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon-box" style="background-color: #FFB800;"><i class="bi bi-people"></i></div>
                    <h1 class="display-3 fw-bold" style="color: #FFB800;">
                        <span class="counter" data-target="5000">0</span>+
                    </h1>
                    <p class="fw-bold text-muted">Zadowolonych klientów <br><small>(przynajmniej rano)</small></p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon-box" style="background-color: var(--promilex-malina);"><i class="bi bi-heart"></i></div>
                    <h1 class="display-3 fw-bold" style="color: var(--promilex-malina);">
                        <span class="counter" data-target="500">0</span>+
                    </h1>
                    <p class="fw-bold text-muted">Produktów premium <br><small>(i kilka dla biednych)</small></p>
                </div>
            </div>
        </div>

        <h2 class="text-center fw-bold mt-5 mb-5" style="color: var(--promilex-malina);">Nasz Zespół 👥</h2>
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="team-card team-marek shadow-sm">
                    <img src="~/images/avatar_marek.png" class="team-avatar" alt="Marek">
                    <h4 class="team-name">Marek</h4>
                    <p class="team-role">Manager</p>
                    <p class="team-desc">Sprzedał swoją duszę za rabat 10%</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="team-card team-anna shadow-sm">
                    <img src="~/images/icon_wine.png" class="team-avatar" alt="Anna">
                    <h4 class="team-name">Anna</h4>
                    <p class="team-role">Sommelierka</p>
                    <p class="team-desc">Zna różnicę między winem a winnym</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="team-card team-piotr shadow-sm">
                    <img src="~/images/icon_beer.png" class="team-avatar" alt="Piotr">
                    <h4 class="team-name">Piotr</h4>
                    <p class="team-role">Specjalista piw</p>
                    <p class="team-desc">Testuje produkty od 15 lat</p>
                </div>
            </div>
        </div>

        <div class="contact-cta-wrapper shadow-lg">
            <h2 class="text-center display-5 fw-bold text-white mb-5">Odwiedź nas! 📍</h2>
            <div class="row g-4 align-items-center">
                <div class="col-md-6">
                    <div class="contact-item"><i class="bi bi-geo-alt-fill fs-4"></i> <div>Adres:<br><b>ul. Alkoholowa 42<br>00-123 Warszawa</b></div></div>
                    <div class="contact-item"><i class="bi bi-clock-fill fs-4"></i> <div>Godziny otwarcia:<br><b>Pn-Pt: 10:00 - 22:00<br>Sb: 10:00 - 23:00</b></div></div>
                </div>
                <div class="col-md-6">
                    <div class="contact-item"><i class="bi bi-telephone-fill fs-4"></i> <div>Telefon:<br><b>+48 123 456 789</b></div></div>
                    <div class="contact-item"><i class="bi bi-envelope-fill fs-4"></i> <div>Email:<br><b>kontakt@@promilex.pl</b></div></div>
                </div>
            </div>
        </div>

        <div class="curiosity-box shadow-sm">
            <i class="bi bi-lightbulb-fill" style="color: var(--promilex-orange);"></i> <b>Ciekawostka:</b> Nazwa "Promilex" pochodzi od łacińskiego "promissio" (obietnica) - obietnica najlepszej jakości! ☀️
        </div>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const counters = document.querySelectorAll('.counter');
            const speed = 100; 

            const startCount = (el) => {
                const target = +el.getAttribute('data-target');
                let count = 0;
                const increment = target / speed;

                const updateCount = () => {
                    count += increment;
                    if (count < target) {
                        el.innerText = Math.ceil(count);
                        setTimeout(updateCount, 20);
                    } else {
                        el.innerText = target;
                    }
                };
                updateCount();
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        startCount(entry.target);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.6 });

            counters.forEach(counter => observer.observe(counter));
        });
    </script>
}