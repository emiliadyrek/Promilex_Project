@model IEnumerable<Promiex.Models.Recenzja>

@{
    ViewData["Title"] = "Rejestr Doznań";
}

<style>
    .rev-index-wrapper {
        background-color: #FEF3DC;
        min-height: 100vh;
        padding: 60px 0;
        font-family: 'Poppins', sans-serif;
    }

    .rev-header {
        text-align: center;
        margin-bottom: 60px;
    }

    .rev-title {
        font-size: 42px;
        font-weight: 900;
        color: #C0308C;
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    .rev-grid-card {
        background: white;
        border-radius: 30px;
        padding: 30px;
        border: none;
        height: 100%;
        transition: all 0.4s ease;
        display: flex;
        flex-direction: column;
        position: relative;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    }

        .rev-grid-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 45px rgba(192, 48, 140, 0.12);
        }

    .rev-rating-badge {
        position: absolute;
        top: -15px;
        right: 25px;
        background: linear-gradient(135deg, #C0308C 0%, #E83A61 100%);
        color: white;
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 20px;
        box-shadow: 0 8px 15px rgba(232, 58, 97, 0.3);
        transform: rotate(5deg);
    }

    .rev-quote-icon {
        color: #FEF3DC;
        font-size: 40px;
        margin-bottom: -20px;
    }

    .rev-content {
        font-style: italic;
        color: #444;
        font-size: 16px;
        line-height: 1.6;
        margin: 20px 0;
        flex-grow: 1;
    }

    .rev-product-info {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        color: #95A5A6;
        letter-spacing: 1px;
        border-top: 1px solid #f8f9fa;
        padding-top: 15px;
    }

    .rev-actions {
        display: flex;
        gap: 8px;
        margin-top: 20px;
        justify-content: center;
    }

    .rev-btn {
        width: 35px;
        height: 35px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        font-size: 14px;
        transition: 0.2s;
    }

    .btn-edit {
        background: #FFB800;
    }
    .btn-details {
        background: #F9812A;
    }
    .btn-delete {
        background: #333;
    }

    .rev-btn:hover {
        transform: scale(1.15);
        color: white;
    }

    .fab-rev-add {
        position: fixed;
        bottom: 40px;
        right: 40px;
        width: 70px;
        height: 70px;
        background: #C0308C;
        color: white;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        box-shadow: 0 10px 25px rgba(192, 48, 140, 0.3);
        transition: 0.3s;
        text-decoration: none;
        z-index: 1000;
    }

        .fab-rev-add:hover {
            transform: scale(1.1) rotate(180deg);
            background: #E83A61;
            color: white;
        }
</style>

<div class="rev-index-wrapper">
    <div class="container">
        
        <div class="rev-header">
            <h1 class="rev-title">Giełda Prawdy 📣</h1>
            <p class="fw-bold text-muted">Zbiór dowodów na to, że nasz towar zmienia życie (albo przynajmniej wieczór).</p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="rev-grid-card shadow-sm">
                        <div class="rev-rating-badge">
                            @item.Ocena
                        </div>
                        
                        <div class="rev-quote-icon">
                            <i class="bi bi-quote"></i>
                        </div>

                        <div class="rev-content">
                            "@item.Tresc"
                        </div>

                        <div class="rev-product-info">
                            <i class="bi bi-box-seam me-1"></i> Produkt ID: #@item.ProduktId
                        </div>

                        <div class="rev-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="rev-btn btn-edit" title="Retuszuj">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="rev-btn btn-details" title="Akta">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="rev-btn btn-delete" title="Spal dowody">
                                <i class="bi bi-trash3-fill"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-chat-dots text-muted display-1 opacity-25"></i>
                    <p class="mt-3 text-muted">Cisza przed burzą... Nikt jeszcze nie odważył się nic napisać.</p>
                </div>
            }
        </div>

    </div>
</div>

<a asp-action="Create" class="fab-rev-add shadow-lg" title="Dodaj zeznanie">
    <i class="bi bi-plus-lg"></i>
</a>