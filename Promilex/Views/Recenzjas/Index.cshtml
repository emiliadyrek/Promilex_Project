@model IEnumerable<Promiex.Models.Recenzja>

@{
    ViewData["Title"] = "Rejestr Doznań";
}

<style>
    .rev-index-wrapper {
        background-color: var(--promilex-bg);
        min-height: 80vh;
        padding: 40px 0;
        transition: background-color var(--transition-speed);
    }

    .rev-header {
        text-align: center;
        margin-bottom: 60px;
    }

    .rev-title {
        font-size: 42px;
        font-weight: 900;
        color: var(--promilex-purple);
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    .rev-grid-card {
        background: var(--card-bg);
        border-radius: 30px;
        padding: 30px;
        border: 1px solid var(--border-color);
        height: 100%;
        transition: all 0.4s ease;
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .rev-grid-card:hover {
        transform: translateY(-10px);
        border-color: var(--promilex-purple) !important;
        box-shadow: 0 20px 45px rgba(142, 68, 173, 0.25) !important;
    }

    .rev-rating-badge {
        position: absolute;
        top: -15px;
        right: 25px;
        background: linear-gradient(135deg, var(--promilex-purple) 0%, var(--promilex-malina) 100%);
        color: white;
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 20px;
        box-shadow: 0 8px 15px rgba(142, 68, 173, 0.4);
        transform: rotate(5deg);
        z-index: 5;
    }

    .rev-quote-icon {
        color: var(--promilex-bg);
        font-size: 40px;
        margin-bottom: -20px;
        transition: 0.3s;
    }

    .rev-grid-card:hover .rev-quote-icon {
        color: var(--promilex-purple);
        opacity: 0.3;
    }

    .rev-content {
        font-style: italic;
        color: var(--text-main);
        font-size: 16px;
        line-height: 1.6;
        margin: 20px 0;
        flex-grow: 1;
    }

    .rev-product-info {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--promilex-malina); 
        letter-spacing: 1px;
        border-top: 1px solid var(--border-color);
        padding-top: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rev-actions {
        display: flex;
        gap: 8px;
        margin-top: 20px;
        justify-content: center;
    }

    .rev-btn {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white !important;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-edit { background: #FFB800; }
    .btn-details { background: var(--promilex-purple); }
    .btn-delete { background: #333; }
    [data-theme="dark"] .btn-delete { background: #444; }

    .rev-btn:hover {
        transform: scale(1.15);
        filter: brightness(1.1);
    }

    .fab-rev-add {
        position: fixed;
        bottom: 40px;
        right: 40px;
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, var(--promilex-purple), var(--promilex-malina));
        color: white !important;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        box-shadow: 0 10px 25px rgba(142, 68, 173, 0.4);
        transition: 0.3s;
        text-decoration: none;
        z-index: 1000;
    }

    .fab-rev-add:hover {
        transform: scale(1.1) rotate(180deg);
        box-shadow: 0 15px 35px rgba(142, 68, 173, 0.6);
    }
</style>

<div class="rev-index-wrapper">
    <div class="container">
        
        <div class="rev-header">
            <h1 class="rev-title">Giełda Prawdy 📣</h1>
            <p class="text-muted">Zbiór dowodów na to, że nasz towar zmienia życie (albo przynajmniej wieczór).</p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="rev-grid-card shadow-sm">
                        <div class="rev-rating-badge">
                            @item.Ocena
                        </div>
                        
                        <div class="rev-quote-icon">
                            <i class="bi bi-quote"></i>
                        </div>

                        <div class="rev-content">
                            "@item.Tresc"
                        </div>

                        <div class="rev-product-info">
                            <i class="bi bi-info-circle me-2"></i>
                            @if (item.Produkt != null)
                            {
                                <span>@item.Produkt.Nazwa</span>
                            }
                            else
                            {
                                <span class="text-muted">Produkt nieznany</span>
                            }
                        </div>

                        <div class="rev-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="rev-btn btn-edit" title="Retuszuj">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="rev-btn btn-details" title="Akta">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="rev-btn btn-delete" title="Spal dowody">
                                <i class="bi bi-trash3-fill"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-chat-dots text-muted display-1 opacity-25"></i>
                    <p class="mt-3 text-muted">Cisza przed burzą... Nikt jeszcze nie odważył się nic napisać.</p>
                </div>
            }
        </div>

    </div>
</div>

<a asp-action="Create" class="fab-rev-add shadow-lg" title="Dodaj zeznanie">
    <i class="bi bi-plus-lg"></i>
</a>