@model Promiex.Models.Kategoria

@{
    ViewData["Title"] = "Usuwanie Kategorii";
}

<style>
    .delete-page-wrapper {
        background-color: #FEF3DC;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .delete-card {
        background: white;
        border-radius: 40px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        max-width: 500px;
        width: 100%;
        overflow: hidden;
        text-align: center;
        border: none;
    }

    .delete-header-danger {
        background: #333; 
        padding: 40px;
        color: white;
    }

    .warning-icon-animate {
        font-size: 60px;
        color: #E83A61;
        display: block;
        margin-bottom: 10px;
        animation: pulseWarning 2s infinite;
    }

    @@keyframes pulseWarning {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.1); opacity: 0.8; }
        100% { transform: scale(1); opacity: 1; }
    }

    .delete-body {
        padding: 40px;
    }

    .category-preview-name {
        font-size: 28px;
        font-weight: 900;
        color: #333;
        background: #f8f9fa;
        padding: 20px;
        border-radius: 20px;
        margin: 20px 0;
        border: 2px dashed #dee2e6;
    }

    .btn-final-delete {
        background: #E83A61;
        color: white;
        border: none;
        padding: 15px 40px;
        border-radius: 50px;
        font-weight: 800;
        text-transform: uppercase;
        width: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(232, 58, 97, 0.3);
    }

    .btn-final-delete:hover {
        background: #c0204a;
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(232, 58, 97, 0.4);
        color: white;
    }

    .cancel-link {
        display: block;
        margin-top: 20px;
        color: #666;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

    .cancel-link:hover {
        color: #333;
    }
</style>

<div class="delete-page-wrapper">
    <div class="delete-card shadow-lg">
        <div class="delete-header-danger">
            <i class="bi bi-exclamation-triangle-fill warning-icon-animate"></i>
            <h2 class="fw-bold m-0">Usuwasz sekcję!</h2>
            <p class="small opacity-75 mt-2">Czy na pewno chcesz pożegnać tę kategorię?</p>
        </div>

        <div class="delete-body">
            <p class="text-muted small text-uppercase fw-bold">Wybrana kategoria:</p>
            <div class="category-preview-name">
                @Html.DisplayFor(model => model.Nazwa)
            </div>

            <p class="text-muted mb-4 px-3">
                <i class="bi bi-info-circle me-1"></i> 
                Upewnij się, że żadne produkty nie są już przypisane do tej kategorii przed jej usunięciem.
            </p>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn-final-delete">
                    <i class="bi bi-trash3-fill me-2"></i> Potwierdzam usunięcie
                </button>
                <a asp-action="Index" class="cancel-link">
                    <i class="bi bi-x-lg me-1"></i> Nie, wróć do listy
                </a>
            </form>
        </div>
    </div>
</div>