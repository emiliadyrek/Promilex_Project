@model IEnumerable<Promiex.Models.Kategoria>

@{
    ViewData["Title"] = "Zarządzaj Kategoriami";
}

<style>
    .cat-index-wrapper {
        background-color: #FEF3DC;
        min-height: 100vh;
        padding: 60px 0;
    }

    .cat-header {
        text-align: center;
        margin-bottom: 50px;
    }

    .cat-title {
        font-size: 42px;
        font-weight: 900;
        color: #C0308C; 
        text-transform: uppercase;
    }

    .category-grid-card {
        background: white;
        border-radius: 25px;
        padding: 30px;
        border: none;
        height: 100%;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

        .category-grid-card:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 40px rgba(192, 48, 140, 0.15);
        }

    .cat-icon-circle {
        width: 80px;
        height: 80px;
        background: #FEF3DC;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        color: #C0308C;
        margin-bottom: 20px;
        transition: 0.3s;
    }

    .category-grid-card:hover .cat-icon-circle {
        background: #C0308C;
        color: white;
    }

    .cat-name {
        font-size: 20px;
        font-weight: 800;
        color: #333;
        margin-bottom: 20px;
    }

    .cat-actions {
        display: flex;
        gap: 8px;
        margin-top: auto;
    }

    .cat-btn {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        transition: 0.2s;
    }

    .btn-e {
        background: #FFB800;
    }
    .btn-d {
        background: #F9812A;
    }
    .btn-x {
        background: #333;
    }

    .cat-btn:hover {
        transform: translateY(-3px);
        filter: brightness(1.1);
        color: white;
    }

    .fab-cat-add {
        position: fixed;
        bottom: 40px;
        right: 40px;
        width: 70px;
        height: 70px;
        background: #C0308C;
        color: white;
        border-radius: 20px; 
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        box-shadow: 0 10px 25px rgba(192, 48, 140, 0.3);
        transition: all 0.3s ease;
        text-decoration: none;
        z-index: 1000;
    }

        .fab-cat-add:hover {
            transform: rotate(90deg) scale(1.1);
            background: #E83A61;
            color: white;
        }
</style>

<div class="cat-index-wrapper">
    <div class="container">
        
        <div class="cat-header">
            <h1 class="cat-title">Twoje Kategorie 🏷️</h1>
            <p class="text-muted">Wybierz swój ulubiony rodzaj zapomnienia.</p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="category-grid-card shadow-sm">
                        <div class="cat-icon-circle">
                            <i class="bi bi-tag-fill"></i>
                        </div>
                        
                        <div class="cat-name">@item.Nazwa</div>

                        <div class="cat-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="cat-btn btn-e" title="Edytuj">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="cat-btn btn-d" title="Szczegóły">
                                <i class="bi bi-eye-fill"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="cat-btn btn-x" title="Usuń">
                                <i class="bi bi-trash3-fill"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-inbox text-muted display-1"></i>
                    <p class="mt-3 text-muted">Brak kategorii? Dodaj pierwszą przyciskiem w rogu!</p>
                </div>
            }
        </div>

    </div>
</div>

<a asp-action="Create" class="fab-cat-add shadow-lg" title="Dodaj nową kategorię">
    <i class="bi bi-plus-lg"></i>
</a>