@model Promiex.Models.Dostawca

@{
    ViewData["Title"] = "Profil Kontrahenta";
}

<style>
    .details-page-wrapper {
        background-color: #FEF3DC;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .details-card {
        background: white;
        border-radius: 50px; 
        box-shadow: 0 30px 70px rgba(0,0,0,0.1);
        max-width: 550px;
        width: 100%;
        overflow: hidden;
        border: none;
        text-align: center;
        animation: fadeInScale 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes fadeInScale {
        from { opacity: 0; transform: scale(0.9) translateY(30px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .sup-visual-header {
        background: linear-gradient(135deg, #C0308C 0%, #E83A61 100%);
        padding: 50px 20px;
        color: white;
        position: relative;
    }

    .sup-icon-large {
        font-size: 80px;
        line-height: 1;
        margin-bottom: 15px;
        display: block;
        filter: drop-shadow(0 10px 15px rgba(0,0,0,0.2));
    }

    .sup-id-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(5px);
        color: white;
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 50px;
        padding: 5px 20px;
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 1px;
        display: inline-block;
        text-transform: uppercase;
    }

    .sup-info-body {
        padding: 50px 40px;
    }

    .label-mini {
        font-weight: 800;
        text-transform: uppercase;
        color: #C0308C;
        letter-spacing: 2px;
        font-size: 11px;
        margin-bottom: 10px;
        display: block;
        opacity: 0.7;
    }

    .sup-main-name {
        font-size: 40px;
        font-weight: 900;
        color: #333;
        margin-bottom: 10px;
        letter-spacing: -1px;
    }

    .sup-contact-info {
        font-size: 20px;
        font-weight: 600;
        color: #E83A61; 
        margin-bottom: 30px;
    }

    .quote-box-styled {
        background: #FEF3DC; 
        border: 2px dashed #C0308C;
        border-radius: 25px;
        padding: 25px;
        margin: 0 auto 40px;
        font-style: italic;
        color: #555;
        max-width: 90%;
        line-height: 1.6;
    }

    .details-action-bar {
        display: flex;
        gap: 12px;
        justify-content: center;
        border-top: 2px solid #f8f9fa;
        padding-top: 30px;
    }

    .btn-sup-edit {
        background: #333; 
        color: white;
        padding: 14px 35px;
        border-radius: 50px;
        font-weight: 800;
        text-decoration: none;
        text-transform: uppercase;
        font-size: 13px;
        transition: 0.3s;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .btn-sup-edit:hover {
        background: #C0308C;
        transform: translateY(-3px);
        color: white;
        box-shadow: 0 15px 30px rgba(192, 48, 140, 0.3);
    }

    .btn-sup-back {
        background: #f8f9fa;
        color: #666;
        padding: 14px 30px;
        border-radius: 50px;
        font-weight: 800;
        text-decoration: none;
        text-transform: uppercase;
        font-size: 13px;
        border: 2px solid #eee;
        transition: 0.3s;
    }

    .btn-sup-back:hover {
        background: #eee;
        color: #333;
        transform: translateY(-3px);
    }
</style>

<div class="details-page-wrapper">
    <div class="details-card shadow-lg">
        
        <div class="sup-visual-header">
            <span class="sup-icon-large">
                <i class="bi bi-shield-check"></i>
            </span>
            <div class="sup-id-badge">
                Partner ID #@Model.Id
            </div>
        </div>

        <div class="sup-info-body">
            <span class="label-mini">Podmiot Gospodarczy</span>
            <h1 class="sup-main-name">@Model.NazwaFirmy</h1>
            
            <div class="sup-contact-info">
                <i class="bi bi-phone-fill me-1"></i> @Model.NumerTelefonu
            </div>

            <div class="quote-box-styled shadow-sm">
                <i class="bi bi-quote fs-2 d-block opacity-25"></i>
                "Nigdy nie pytaj ich o skład, a oni nigdy nie zapytają, co stało się z poprzednim dostawcą. Czysty układ, zero świadków."
            </div>

            <div class="details-action-bar">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-sup-edit">
                    <i class="bi bi-pencil-square me-2"></i> Edytuj
                </a>
                <a asp-action="Index" class="btn-sup-back">
                    <i class="bi bi-arrow-left me-2"></i> Powrót
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}