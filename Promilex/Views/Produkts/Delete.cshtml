@model Promiex.Models.Produkt

@{
    ViewData["Title"] = "Usuwanie produktu";
}

<style>
    .delete-page-wrapper {
        background-color: #FEF3DC;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 0;
    }

    .delete-card {
        background: white;
        border-radius: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        padding: 40px;
        max-width: 600px;
        width: 100%;
        text-align: center;
        border-top: 8px solid #dc3545; /* Czerwony pasek ostrzegawczy */
    }

    .warning-icon {
        font-size: 60px;
        color: #dc3545;
        margin-bottom: 20px;
    }

    .product-preview-box {
        background: #fdf2f4;
        border-radius: 20px;
        padding: 25px;
        margin: 25px 0;
        text-align: left;
    }

    .info-label {
        font-weight: 800;
        color: #666;
        font-size: 13px;
        text-transform: uppercase;
        margin-bottom: 2px;
    }

    .info-value {
        font-size: 18px;
        color: #333;
        margin-bottom: 15px;
    }

    .info-value-price {
        font-size: 24px;
        font-weight: 900;
        color: #E83A61;
    }

    .btn-delete-final {
        background: #dc3545;
        color: white;
        border: none;
        padding: 12px 35px;
        border-radius: 50px;
        font-weight: 700;
        transition: 0.3s;
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
    }

        .btn-delete-final:hover {
            background: #a71d2a;
            transform: scale(1.05);
            color: white;
        }

    .btn-cancel {
        color: #666;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-cancel:hover {
            color: #333;
        }
</style>

<div class="delete-page-wrapper">
    <div class="delete-card">
        <div class="warning-icon">
            <i class="bi bi-exclamation-octagon-fill"></i>
        </div>
        
        <h2 class="fw-bold">Chwileczkę! 🛑</h2>
        <p class="text-muted">Czy na pewno chcesz na zawsze usunąć ten trunek z naszej spiżarni?</p>

        <div class="product-preview-box">
            <div class="info-label">Nazwa produktu</div>
            <div class="info-value">@Model.Nazwa</div>

            <div class="info-label">Opis</div>
            <div class="info-value">@Model.Opis</div>

            <div class="row">
                <div class="col-6">
                    <div class="info-label">Cena</div>
                    <div class="info-value-price">@Model.Cena.ToString("N2") zł</div>
                </div>
                <div class="col-6 text-end">
                    <div class="info-label">Moc</div>
                    <div class="info-value">@Model.ZawartoscAlkoholu%</div>
                </div>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex flex-column gap-3 align-items-center">
                <button type="submit" class="btn btn-delete-final">
                    <i class="bi bi-trash3-fill me-2"></i> Tak, usuń bezpowrotnie
                </button>
                <a asp-action="Index" class="btn-cancel">
                    Nie, rozmyśliłem się – wróć do listy
                </a>
            </div>
        </form>
    </div>
</div>