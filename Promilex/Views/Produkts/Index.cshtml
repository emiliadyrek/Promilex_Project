@model IEnumerable<Promiex.Models.Produkt>

@{
    ViewData["Title"] = "Nasze Trunki";
}

<style>
    .products-page {
        background-color: #FEF3DC; 
        min-height: 100vh;
        padding-bottom: 100px;
        font-family: 'Segoe UI', sans-serif;
    }

    .products-header {
        text-align: center;
        padding: 60px 0;
    }

    .products-title {
        font-size: 48px;
        font-weight: 900;
        color: #F9812A;
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    .product-card {
        background: white;
        border: none;
        border-radius: 30px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        position: relative;
    }

    .product-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 20px 40px rgba(249, 129, 42, 0.15);
    }

    .fk-badges {
        margin-bottom: 10px;
        display: flex;
        justify-content: center;
        gap: 5px;
        flex-wrap: wrap;
    }

    .badge-kategoria {
        background: #F9812A;
        color: white;
        font-size: 10px;
        padding: 3px 10px;
        border-radius: 50px;
        text-transform: uppercase;
        font-weight: 700;
    }

    .badge-producent {
        background: #333;
        color: white;
        font-size: 10px;
        padding: 3px 10px;
        border-radius: 50px;
        text-transform: uppercase;
        font-weight: 700;
    }

    .product-img-box {
        height: 180px;
        background: #fffcf7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 70px;
        border-bottom: 2px solid #FEF3DC;
    }

    .alcohol-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(232, 58, 97, 0.1);
        color: #E83A61;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 12px;
        z-index: 10;
    }

    .product-info { padding: 20px; text-align: center; }
    .product-name { font-size: 20px; font-weight: 800; color: #333; margin-bottom: 5px; }
    .product-desc { color: #777; font-size: 13px; height: 38px; overflow: hidden; margin-bottom: 10px; }
    .product-price-tag { font-size: 24px; font-weight: 900; color: #E83A61; margin-bottom: 15px; }
    .btn-actions-group { display: flex; justify-content: center; gap: 8px; border-top: 1px solid #eee; padding-top: 15px; }
    .circle-btn { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; text-decoration: none; transition: 0.3s; }
    .btn-edit { background-color: #FFB800; }
    .btn-details { background-color: #F9812A; }
    .btn-delete { background-color: #333; }
    .fab-add { position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; background: linear-gradient(135deg, #F9812A 0%, #E83A61 100%); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 25px; box-shadow: 0 10px 20px rgba(232, 58, 97, 0.3); text-decoration: none; z-index: 1000; }
</style>

<div class="products-page">
    <div class="container">
        <div class="products-header">
            <h1 class="products-title">Nasza Spiżarnia 🍷</h1>
            <p class="text-muted">Obsługa relacji: Kategoria & Producent</p>
        </div>

        <div class="row g-4">
            @foreach (var item in Model) {
                <div class="col-md-4 col-lg-3">
                    <div class="product-card shadow-sm">
                        <div class="alcohol-badge">
                            <i class="bi bi-percent"></i> @item.ZawartoscAlkoholu%
                        </div>

                        <div class="product-img-box">
                            @if (item.Nazwa.ToLower().Contains("wino")) { <span>🍷</span> }
                            else if (item.Nazwa.ToLower().Contains("piwo")) { <span>🍺</span> }
                            else { <span>🍾</span> }
                        </div>
                        
                        <div class="product-info">
                            <div class="fk-badges">
                                @if (item.Kategoria != null) {
                                    <span class="badge-kategoria">@item.Kategoria.Nazwa</span>
                                }
                                @if (item.Producent != null) {
                                    <span class="badge-producent">@item.Producent.Nazwa</span>
                                }
                            </div>

                            <h3 class="product-name">@item.Nazwa</h3>
                            <p class="product-desc">@item.Opis</p>
                            <div class="product-price-tag">@item.Cena.ToString("N2") zł</div>
                            
                            <div class="btn-actions-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="circle-btn btn-edit"><i class="bi bi-pencil-fill"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="circle-btn btn-details"><i class="bi bi-search"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="circle-btn btn-delete"><i class="bi bi-trash3-fill"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<a asp-action="Create" class="fab-add shadow-lg"><i class="bi bi-plus-lg"></i></a>