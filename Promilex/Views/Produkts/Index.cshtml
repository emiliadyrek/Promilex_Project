@model IEnumerable<Promiex.Models.Produkt>

@{
    ViewData["Title"] = "Nasza Spiżarnia";
}

<style>
    .products-page {
        background-color: var(--promilex-bg); 
        min-height: 80vh;
        padding-bottom: 60px;
        transition: background-color var(--transition-speed);
    }

    .products-header {
        text-align: center;
        padding: 60px 0;
    }

    .products-title {
        font-size: 48px;
        font-weight: 900;
        color: var(--promilex-purple);
        text-transform: uppercase;
        letter-spacing: -1px;
    }

    .product-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 35px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        height: 100%;
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .product-card:hover {
        transform: translateY(-12px);
        border-color: var(--promilex-purple) !important;
        box-shadow: 0 20px 40px rgba(142, 68, 173, 0.4) !important;
    }

    .product-img-box {
        height: 180px;
        background: var(--promilex-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 75px;
        border-bottom: 1px solid var(--border-color);
        transition: 0.3s;
    }

    .alcohol-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: var(--promilex-malina);
        color: white; 
        padding: 5px 12px;
        border-radius: 15px;
        font-weight: 800;
        font-size: 13px;
        z-index: 10;
        box-shadow: 0 4px 12px rgba(232, 58, 97, 0.3);
    }

    .ingredients-count {
        position: absolute;
        top: 15px;
        right: 15px;
        background: var(--promilex-purple); 
        color: white;
        padding: 5px 12px;
        border-radius: 15px;
        font-weight: 800;
        font-size: 13px;
        z-index: 10;
        box-shadow: 0 4px 12px rgba(142, 68, 173, 0.3);
    }

    .product-info { 
        padding: 25px 20px; 
        text-align: center; 
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .product-name { 
        font-size: 22px; 
        font-weight: 800; 
        color: var(--text-main); 
        margin-bottom: 8px; 
        line-height: 1.2; 
    }

    .product-desc { 
        color: var(--text-muted); 
        font-size: 13px; 
        height: 38px; 
        overflow: hidden; 
        margin-bottom: 15px; 
        line-height: 1.4; 
    }
    
    .product-price-tag { 
        font-size: 26px; 
        font-weight: 900; 
        color: var(--promilex-malina);
        margin-top: auto; 
        padding-bottom: 15px; 
    }
    
    .btn-actions-group { 
        display: flex; 
        justify-content: center; 
        gap: 12px; 
        padding: 15px;
        background: var(--promilex-bg);
        border-top: 1px solid var(--border-color);
    }
    
    .circle-btn { 
        width: 42px; 
        height: 42px; 
        border-radius: 14px; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        color: white !important; 
        text-decoration: none; 
        transition: all 0.3s ease; 
        font-size: 16px;
    }
    
    .btn-edit { background: #FFB800; }
    .btn-details { background: var(--promilex-purple); }
    .btn-delete { background: #333; }
    [data-theme="dark"] .btn-delete { background: #444; }
    
    .circle-btn:hover {
        transform: translateY(-3px) scale(1.1);
        filter: brightness(1.1);
    }

    .fab-add { 
        position: fixed; 
        bottom: 40px; 
        right: 40px; 
        width: 70px; 
        height: 70px; 
        background: linear-gradient(135deg, var(--promilex-purple) 0%, var(--promilex-malina) 100%); 
        color: white !important; 
        border-radius: 22px; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        font-size: 28px; 
        box-shadow: 0 15px 35px rgba(142, 68, 173, 0.4); 
        text-decoration: none; 
        z-index: 1000; 
        transition: 0.4s;
    }

    .fab-add:hover {
        transform: rotate(90deg) scale(1.1);
        box-shadow: 0 15px 35px rgba(142, 68, 173, 0.6);
    }

    .fk-badges .badge-custom {
        font-size: 10px;
        padding: 4px 12px;
        border-radius: 50px;
        text-transform: uppercase;
        font-weight: 800;
        margin: 2px;
        display: inline-block;
    }
    .badge-kategoria { background: var(--promilex-orange); color: white; }
    
    .badge-producent { 
        background: #E0E0E0; 
        color: #000000 !important; 
    }
</style>

<div class="products-page">
    <div class="container">
        <div class="products-header">
            <h1 class="products-title">Nasza Spiżarnia</h1>
            <p class="text-muted">Twoja prywatna kolekcja trunków i receptur.</p>
        </div>

        <div class="row g-4">
            @foreach (var item in Model) {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="product-card shadow-sm">
                        <div class="alcohol-badge">
                            <i class="bi bi-percent"></i> @item.ZawartoscAlkoholu
                        </div>

                        <div class="ingredients-count" title="Liczba składników w recepturze">
                            <i class="bi bi-funnel-fill me-1"></i> @(item.Skladniki?.Count() ?? 0)
                        </div>

                        <div class="product-img-box">
                            @{
                                string n = item.Nazwa?.ToLower() ?? "";
                                if (n.Contains("wino")) { <span>🍷</span> }
                                else if (n.Contains("piwo")) { <span>🍺</span> }
                                else if (n.Contains("szampan") || n.Contains("prosecco")) { <span>🥂</span> }
                                else if (n.Contains("wódka") || n.Contains("nalewka") || n.Contains("whisky")) { <span>🥃</span> }
                                else { <span>🍾</span> }
                            }
                        </div>
                        
                        <div class="product-info">
                            <div class="fk-badges mb-2">
                                @if (item.Kategoria != null) {
                                    <span class="badge-custom badge-kategoria">@item.Kategoria.Nazwa</span>
                                }
                                @if (item.Producent != null) {
                                    <span class="badge-custom badge-producent">@item.Producent.Nazwa</span>
                                }
                            </div>

                            <h3 class="product-name">@item.Nazwa</h3>
                            <p class="product-desc">@item.Opis</p>
                            
                            <div class="product-price-tag">
                                @item.Cena.ToString("N2") <small style="font-size: 14px;">zł</small>
                            </div>
                            
                            <div class="btn-actions-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="circle-btn btn-edit" title="Edytuj"><i class="bi bi-pencil-fill"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="circle-btn btn-details" title="Szczegóły"><i class="bi bi-search"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="circle-btn btn-delete" title="Usuń"><i class="bi bi-trash3-fill"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-box2-heart text-muted display-1"></i>
                    <h3 class="mt-3 text-muted">Spiżarnia jest pusta...</h3>
                    <p>Czas coś uwarzyć! Dodaj pierwszy produkt.</p>
                </div>
            }
        </div>
    </div>
</div>

<a asp-action="Create" class="fab-add shadow-lg" title="Dodaj nowy produkt">
    <i class="bi bi-plus-lg"></i>
</a>